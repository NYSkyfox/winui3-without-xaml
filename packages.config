<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- WindowsAppSDK 2.x 起主包是"伞形包"，需要显式列出全部 10 个子包
       （packages.config 不传递依赖，否则构建会报 transitive dependencies 错误） -->
  <package id="Microsoft.WindowsAppSDK" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Base" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Foundation" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.InteractiveExperiences" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.WinUI" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.DWrite" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Widgets" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.AI" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.ML" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Search" version="2.5.1" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Runtime" version="2.5.1" targetFramework="native" />

  <!-- C++/WinRT 投影 -->
  <package id="Microsoft.Windows.CppWinRT" version="3.0.260818.1" targetFramework="native" />
  <!-- WinMD 合并工具等 -->
  <package id="Microsoft.Windows.SDK.BuildTools" version="10.0.28000.2705" targetFramework="native" />
</packages>